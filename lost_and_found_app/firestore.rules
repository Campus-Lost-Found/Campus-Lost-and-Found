rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUserProfile() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function currentRole() {
      return get(userPath(request.auth.uid)).data.role;
    }

    function isStaff() {
      return hasUserProfile() &&
        (currentRole() == 'staff' || currentRole() == 'admin');
    }

    function isAdmin() {
      return hasUserProfile() && currentRole() == 'admin';
    }

    match /users/{uid} {
      allow create: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['name', 'email', 'role']) &&
        request.resource.data.role == 'student' &&
        request.resource.data.email == request.auth.token.email;

      allow read: if signedIn() &&
        (request.auth.uid == uid || isAdmin());

      allow update: if signedIn() &&
        ((request.auth.uid == uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name'])) ||
         (isAdmin() &&
          request.resource.data.role in ['student', 'staff', 'admin'] &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['role'])));

      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    match /reports/{reportId} {
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerEmail == request.auth.token.email &&
        request.resource.data.status == 'Open';

      allow read: if signedIn() &&
        (resource.data.ownerId == request.auth.uid || isStaff());

      allow update: if isStaff() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status']) &&
        request.resource.data.status in
          ['Open', 'Under Review', 'Resolved', 'Rejected'];

      allow delete: if isAdmin();
    }

    match /claims/{claimId} {
      allow create: if signedIn() &&
        request.resource.data.claimantId == request.auth.uid &&
        request.resource.data.claimantEmail == request.auth.token.email &&
        request.resource.data.status == 'Pending' &&
        exists(/databases/$(database)/documents/reports/$(request.resource.data.reportId));

      allow read: if signedIn() &&
        (resource.data.claimantId == request.auth.uid || isStaff());

      allow update: if isStaff() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status']) &&
        request.resource.data.status in ['Pending', 'Approved', 'Rejected'];

      allow delete: if isAdmin();
    }
  }
}
